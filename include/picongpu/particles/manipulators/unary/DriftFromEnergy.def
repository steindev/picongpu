#pragma once

#include "picongpu/param/physicalConstants.param"
#include "picongpu/particles/manipulators/generic/Free.def"

#include <pmacc/math/operation.hpp>

namespace picongpu
{
    namespace particles
    {
        namespace manipulators
        {
            namespace unary
            {
                namespace param
                {
                    //! configuration for the unary manipulator functor DriftFromEnergy
                    struct DriftFromEnergyCfg
                    {
                        /** Initial particle energy
                         *  Examples:
                         *    - No drift is equal to rest mass times square of speed of light
                         *  unit: keV
                         */
                        static constexpr float_64 energy = 1._X;
                        /** Define initial particle drift direction vector.
                         */
                        static constexpr auto driftDirection = float3_X(-1.0, 0.0, 0.0);
                    };
                } // namespace param

                namespace acc
                {
                    template<typename T_ParamClass, typename T_ValueFunctor>
                    struct DriftFromEnergy;
                } // namespace acc

                /** change particle's momentum based on energy
                 *
                 * allow to manipulate a momentum to a particle
                 *
                 * @tparam T_ParamClass param::DriftFromEnergyCfg, configuration parameter
                 * @tparam T_ValueFunctor pmacc::math::operation::*,  binary functor type to manipulate the momentum
                 * attribute
                 */
                template<
                    typename T_ParamClass = param::DriftFromEnergyCfg,
                    typename T_ValueFunctor = pmacc::math::operation::Add>
                using DriftFromEnergy = generic::Free<acc::DriftFromEnergy<T_ParamClass, T_ValueFunctor>>;

            } // namespace unary
        } // namespace manipulators
    } // namespace particles
} // namespace picongpu
