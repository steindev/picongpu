#pragma once

#include "picongpu/defines.hpp"

#include <pmacc/particles/algorithm/ForEach.hpp>

#include <cstdint>

namespace picongpu::particles::photonTransport::kernel
{
    /** update photon momentum kernel
     *
     * @attention assumes that momentum or energy difference values are known
     *
     * called by updatePhotons sub-stage, changes the momentum of all macro particles
     *  of the species T_Photon by applying the T_Scatterer functor to each macro particle.
     */
    template<
        typename T_Photon,
        typename T_Scatterer
    >
    struct UpdatePhotonMomentumKernel
    {
        /** call operator
         *
         * called by updatePhotons sub-stage
         *
         * @param worker object containing the device and block
         *  information, passed by PMACC_KERNEL call
         * @param areaMapping mapping of blockIndex to block superCell index
         * @param photonBox deviceDataBox giving access to the photon species' particle frames
         *   of all local superCells
         */
        template<
            typename T_Worker,
            typename T_AreaMapping,
            typename T_PhotonBox>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_AreaMapping const areaMapping,
            T_PhotonBox photonBox) const
        {
            pmacc::DataSpace<simDim> const superCellIdx = areaMapping.getSuperCellIndex(worker.blockDomIdxND());

            auto forEachLocalPhotonBoxEntry
                = pmacc::particles::algorithm::acc::makeForEach(worker, photonBox, superCellIdx);

            // end kernel if superCell already finished or if contains no particles
            if( !forEachLocalPhotonBoxEntry.hasParticles() )
                return;

            // for each photon call the PhotonScatterer to update its momentum
            // Alltough the worker is not required for execution of the scatterer,
            // it is an argument of the lambda function because the forEach functor will call
            // this lambda with two arguments
            forEachLocalPhotonBoxEntry(
                [&](T_Worker const& , auto& photon)
                { T_Scatterer{}(photon); });
        }
    };
} // namespace picongpu::particles::photonScatterer::kernel